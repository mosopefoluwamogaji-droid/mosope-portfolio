# Copy this file to .env for local testing (never commit the real .env).
# On Render, set these as real Environment Variables instead — do not
# upload a .env file there.

PORT=4001

# Brevo (formerly Sendinblue) — get these from app.brevo.com
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com

# Where contact form messages get delivered
RECEIVING_EMAIL=mosopemogaji@gmail.com

# The deployed portfolio site's URL (comma-separate if more than one,
# e.g. your live domain + a local dev address)
CORS_ORIGIN=https://your-portfolio-site.onrender.com
